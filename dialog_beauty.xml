<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#1A1A1A">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Beauty Tools"
        android:textSize="20sp"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:layout_marginBottom="24dp" />

    <!-- Smooth Skin -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Smooth Skin"
        android:textSize="14sp"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="8dp" />

    <com.google.android.material.slider.Slider
        android:id="@+id/smoothSkinSlider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:valueFrom="0"
        android:valueTo="1"
        android:value="0"
        android:stepSize="0.01"
        app:thumbColor="#6200EE"
        app:trackColorActive="#6200EE"
        app:trackColorInactive="#666666"
        android:layout_marginBottom="24dp" />

    <!-- Whiten Teeth -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Whiten Teeth"
        android:textSize="14sp"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnWhitenTeeth"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Select Teeth Area"
        android:textColor="#FFFFFF"
        android:backgroundTint="#424242"
        android:layout_marginBottom="24dp" />

    <!-- Brighten Eyes -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Brighten Eyes"
        android:textSize="14sp"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnBrightenEyes"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Select Eye Area"
        android:textColor="#FFFFFF"
        android:backgroundTint="#424242"
        android:layout_marginBottom="24dp" />

    <!-- Info Text -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tip: For best results with teeth and eyes, select the specific area on your photo."
        android:textSize="12sp"
        android:textColor="#999999"
        android:layout_marginBottom="16dp" />

    <!-- Apply Button -->
    <Button
        android:id="@+id/btnApply"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Apply"
        android:textColor="#FFFFFF"
        android:backgroundTint="#6200EE" />

</LinearLayout>
